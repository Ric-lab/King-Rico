        && x.keys().hasOnly(['move','roundId','betUnits','peachAt','floor','savedUnits','ok','ended','winUnits'])
        && x.move in ['start','climb','collect'] && x.ok is bool && x.ended is bool
        && x.roundId is string && x.roundId.matches('^[0-9a-fA-F-]{36}$')
        && x.betUnits in [100,250,500,1000,2500,5000,10000,25000,50000,100000]
        && x.betUnits == r.betUnits && o.betUnits == (first ? x.betUnits : 0)
        && (first ? x.move == 'start' : x.move != 'start' && x.roundId == r.id && x.peachAt == r.peachAt)
        && x.floor is int && x.floor >= 0 && x.floor <= 33 && x.savedUnits is int
        && x.peachAt is int && (x.peachAt == 0 || x.peachAt >= 6 && x.peachAt <= 20)
        && (x.move == 'collect' ? !first && r.floor >= 1 && x.floor == r.floor && x.ok && x.ended && x.savedUnits == r.savedUnits && o.winUnits == prize
          : x.floor == r.floor + (x.ok ? 1 : 0) && x.ended == (!x.ok || x.floor == 33)
            && x.savedUnits == (x.ok && x.floor == x.peachAt ? prize : r.savedUnits)
            && o.winUnits == (x.ended ? x.ok ? prize : x.savedUnits : 0))
        && p.get('neckRound',null) == (x.ended ? null : {'id':x.roundId,'betUnits':x.betUnits,'floor':x.floor,'peachAt':x.peachAt,'savedUnits':x.savedUnits})
        && old.balanceUnits >= o.betUnits && p.balanceUnits == old.balanceUnits - o.betUnits + o.winUnits
        && p.lastSpinAt == request.time && p.firstSpinAt == (old.firstSpinAt == null ? request.time : old.firstSpinAt)
        && (old.lastSpinAt == null || request.time >= old.lastSpinAt + duration.value(300,'ms'))
        && result.keys().hasOnly(['player','game','bet','balanceBefore','balanceDebited','outcome','baseBalance'])
        && result.game == 'neck' && result.bet == x.betUnits / 100.0
        && result.balanceBefore == old.balanceUnits / 100.0
        && result.balanceDebited == (old.balanceUnits - o.betUnits) / 100.0 && x.winUnits == o.winUnits;
    }
    function fingoNumbers(n) {
      let a = n[0]; let b = n[1]; let c = n[2]; let d = n[3]; let e = n[4];
      return n is list && n.size() == 5
        && a is int && a >= 1 && a <= 15
        && b is int && b >= 16 && b <= 30
        && c is int && c >= 31 && c <= 45
        && d is int && d >= 46 && d <= 60
        && e is int && e >= 61 && e <= 75;
    }
    function fingoMark(x, r, c) {
      return x.marks[c] == (r.marks[c] || x.bin == c && r.slots[c] == r.targets[c]);
    }
    function fingoDrop(x, r, o) {
      let complete = x.marks == [true,true,true,true,true];
      let prize = int(x.betUnits * [2500,2500,800,400,200,100,40][int((x.used - 1) / 3)] / 100);
      return r.slots != null && o.selected is int && o.selected >= 0 && o.selected <= 4 && x.bin >= 0 && x.bin <= 4
        && x.slots == r.slots && x.used == r.used + 1
        && fingoMark(x,r,0) && fingoMark(x,r,1) && fingoMark(x,r,2) && fingoMark(x,r,3) && fingoMark(x,r,4)
        && x.ended == (complete || x.used == 21) && o.winUnits == (complete ? prize : 0);
    }
    function fingo(p, old, o) {
