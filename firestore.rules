        && (old.lastSpinAt == null || request.time >= old.lastSpinAt+duration.value(700,'ms'))
        && o.result.keys().hasOnly(['player','game','bet','balanceBefore','balanceDebited','outcome','baseBalance'])
        && o.result.game == 'claw' && o.result.bet == o.betUnits / 100.0
        && o.result.balanceBefore == old.balanceUnits / 100.0 && o.result.balanceDebited == (old.balanceUnits-o.betUnits) / 100.0 && o.result.baseBalance == p.balanceUnits / 100.0;
    }
    function gravityWinner(seed) {
      return ([0,3,1,2,3,4,0,0,4,0,4,3,1,3,1,2,1,0,1,0,4,3,0,0,1,1,3,0,0,3,0,4][int(seed / 5)] + seed%5)%5;
    }
    function race(p,old,o) {
      let x=o.result.outcome; let modern=x.get('version',1) >= 2; let physical=x.get('version',1) == 3; let circus=x.get('version',1) == 4; let count=modern ? 5 : 4; let factor=modern ? 48 : 38;
      let pick2=x.get('selected2',-1); let w4=int(x.seed%20 / 4);
      return o.action == 'race' && o.game == 'race' && o.selected == x.selected
        && p.diff(old).affectedKeys().hasOnly(['balanceUnits','settings','lastSpinAt','firstSpinAt','revision','updatedAt','lastOperationId'])
        && p.settings.diff(old.settings).affectedKeys().hasOnly(['raceBetIdx'])
        && p.settings.raceBetIdx is int && p.settings.raceBetIdx >= 0 && p.settings.raceBetIdx <= 9
        && o.betUnits == [100,250,500,1000,2500,5000,10000,25000,50000,100000][p.settings.raceBetIdx]
        && x.keys().hasOnly(['roundId','betUnits','selected','seed','winner','ended','winUnits','version','selected2','second'])
        && x.roundId == p.lastOperationId && x.betUnits == o.betUnits
        && x.selected is int && x.selected >= 0 && x.selected < count
        && x.seed is int && x.seed >= 0 && x.get('version',1) in [1,2,3,4] && x.ended == true && o.winUnits == x.winUnits
        && (circus ? x.keys().hasAll(['selected2','second']) && x.seed <= 639 && pick2 is int && pick2 >= -1 && pick2 <= 4 && pick2 != x.selected
            && x.winner == w4 && x.second == (w4+1+x.seed%4)%5
            && x.winUnits == (pick2 == -1 ? (x.selected == x.winner ? int(o.betUnits*48 / 10) : 0) : (x.selected == x.winner && pick2 == x.second ? int(o.betUnits*192 / 10) : 0))
          : !('selected2' in x) && !('second' in x) && x.seed <= (physical ? 159 : modern ? 65534 : 65535)
            && x.winner == (physical ? gravityWinner(x.seed) : x.seed%count) && x.winUnits == (x.selected == x.winner ? int(o.betUnits*factor / 10) : 0))
        && old.balanceUnits >= o.betUnits && p.balanceUnits == old.balanceUnits-o.betUnits+o.winUnits
        && p.balanceUnits is int && p.balanceUnits >= 0 && p.balanceUnits <= 1000000000000
        && p.lastSpinAt == request.time && p.firstSpinAt == (old.firstSpinAt == null ? request.time : old.firstSpinAt)
        && (old.lastSpinAt == null || request.time >= old.lastSpinAt+duration.value(700,'ms'))
        && o.result.keys().hasOnly(['game','bet','balanceBefore','balanceDebited','outcome','baseBalance'])
        && o.result.game == 'race' && o.result.bet == o.betUnits / 100.0
        && o.result.balanceBefore == old.balanceUnits / 100.0 && o.result.balanceDebited == (old.balanceUnits-o.betUnits) / 100.0 && o.result.baseBalance == p.balanceUnits / 100.0;
    }
    function legacyPlayer(player, expected) {
      return player.diff(expected).affectedKeys().hasOnly(['neckRound','fingoRound','penaltyRound','clownRound','bounceRound','flyingRound','twentyOneRound'])
        && player.get('neckRound',null) == expected.neckRound && player.get('fingoRound',null) == expected.fingoRound
        && player.get('penaltyRound',null) == expected.penaltyRound && player.get('clownRound',null) == expected.clownRound
        && player.get('bounceRound',null) == expected.bounceRound
        && player.get('flyingRound',expected.flyingRound) == expected.flyingRound && player.get('twentyOneRound',expected.twentyOneRound) == expected.twentyOneRound;
    }
    function legacyFinancialPlayer(p,o) {
      let player=o.result.player;
      let expected = {'balance':p.balanceUnits / 100.0,'peaches':p.peaches,'bonus':p.bonus,'settings':p.settings,'analyticsConsent':p.analyticsConsent,'revision':p.revision,
        'neckRound':p.get('neckRound',null),'fingoRound':p.get('fingoRound',null),'penaltyRound':p.get('penaltyRound',null),'clownRound':p.get('clownRound',null),'bounceRound':p.get('bounceRound',null),'flyingRound':p.get('flyingRound',null),'twentyOneRound':p.get('twentyOneRound',null)};
      return o.rulesVersion == '2026-10-19-spark-v3' ? player.diff(expected).affectedKeys().hasOnly(['flyingRound','twentyOneRound'])
        && player.get('flyingRound',expected.flyingRound) == expected.flyingRound && player.get('twentyOneRound',expected.twentyOneRound) == expected.twentyOneRound : legacyPlayer(player,expected);
    }
    function financial(uid, p, old) {
      let path = operationPath(uid, p.lastOperationId);
      let o = getAfter(path).data;
      return p.lastOperationId is string && p.lastOperationId.matches('^[0-9a-fA-F-]{36}$')
        && p.lastOperationId != old.lastOperationId && !exists(path) && operation(o)
        && (o.rulesVersion in ['2026-10-20-spark-v4','2026-10-22-balance-v5','2026-10-23-guided-v6','2026-10-23-ladder-v7'] ? !('player' in o.result) : legacyFinancialPlayer(p,o))
        && (o.action == 'race' ? race(p,old,o) : o.action == 'claw' ? claw(p,old,o) : o.action == 'twentyOne' ? twentyOne(p,old,o) : o.action == 'flying' ? flying(p,old,o) : o.action == 'bounce' ? bounce(p, old, o) : o.action == 'clown' ? clown(p, old, o) : o.action == 'penalty' ? penalty(p, old, o) : o.action == 'fingo' ? fingo(p, old, o) : o.action == 'neck' ? neck(p, old, o) : (o.action == 'recharge' ? recharge(p, old, o) : spin(p, old, o) || bonus(p, old, o)));
    }
    match /players/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid) && initial(request.resource.data);
      allow update: if owner(uid) && request.resource.data.updatedAt == request.time
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.analyticsFromCreation == resource.data.analyticsFromCreation
        && request.resource.data.revision == resource.data.revision + 1
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['settings','analyticsConsent','revision','updatedAt'])
            && settings(request.resource.data.settings) && request.resource.data.analyticsConsent is bool
          || financial(uid, request.resource.data, resource.data));
      match /operations/{operationId} {
        allow read: if owner(uid);
        allow create: if owner(uid) && operation(request.resource.data)
          && getAfter(/databases/$(database)/documents/players/$(uid)).data.lastOperationId == operationId
          && getAfter(/databases/$(database)/documents/players/$(uid)).data.revision
             == get(/databases/$(database)/documents/players/$(uid)).data.revision + 1;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
